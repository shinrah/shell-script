CHECK HTTPD SERVICE AND START IF NOT WORKING

#!/bin/bash
apache="httpd"

if systemctl is-active --quiet "$apache" ; then 
    echo "$apache is running"
else
    echo "$apache need to start" 
     systemctl start "$apache" 
if systemctl is-active --quiet "$apache" ; then
    echo "$apache started sucessfully"
else
    echo "service having issue"
    fi 

fi 


