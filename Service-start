#!/bin/bash
Email="rahoolnew@gmail.com"
keywords="Failed|error|denied|refused"

if journalctl --since "1 hour ago" | grep -Ei "$keywords" > /tmp/log_alert.txt; then
        if [ -s /tmp/log_alert.txt ]; then
         mail -s "Alert email detected on $(hostname)" "$Email" < /tmp/log_alert.txt
        fi 
fi 
########################################################################################################################################################

check root filesystem utilization

#!/bin/bash
use=$(df / | awk 'NR==2{print $5}' | sed 's/%//')

if [ $use -ge 80 ]; then
     echo "disk is high: ${use}%"
else
     echo "disk is ok: ${use}%"
fi


##############################################################################################################################################################

check CPU utilization 

#!/bin/bash

cpu=$(top -bn1 | grep "Cpu(s)" | awk '{print $2}' | cut -d. -f1)

if [ $cpu -ge 80 ]; then
   echo "High CPU usage: ${cpu}%"
else
   echo "CPU usage normal: ${cpu}%"
fi
####################################################################################################################################################################

check memory usage

#!/bin/bash

ram=$(free | awk 'FNR == 2 {print ($3/$2)*100}' | cut -d. -f1)

if [ $ram -ge 80 ]; then
  echo "High ram usage: ${ram}%"
else
  echo "Ram usage normal: ${ram}%"
fi
