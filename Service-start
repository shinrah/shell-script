CHECK SSHD SERVICE AND START IF NOT WORKING

#!/bin/bash
service="sshd"

if systemctl is-active --quiet "$service" ; then
   echo "service is running"

else 
    echo "service need to start"
    systemctl start "$service"

if systemctl is-active --quiet "$service" ; then
    echo "$service is started sucessfuly"
else
    echo "service having issue"
    fi  
fi 




